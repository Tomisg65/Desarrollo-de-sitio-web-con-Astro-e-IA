---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
    { name: "Inicio", href: "/" },
    { name: "Tecnologías de apoyo", href: "/tecnologias" },
    { name: "Aplicaciones", href: "/aplicaciones" },
    { name: "Recursos", href: "/recursos" },
];
---

<header class="header">
    <div class="nav-container">
        <a href="/" class="logo">
            <span class="logo-icon">♿</span>
            <span>InclusiónTech</span>
        </a>

        <nav aria-label="Navegación principal">
            <ul class="nav-links">
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class={
                                    pathname === item.href ||
                                    (item.href !== "/" &&
                                        pathname.startsWith(item.href))
                                        ? "active"
                                        : ""
                                }
                            >
                                {item.name}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    .header {
        background-color: #ffffff;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.35rem;
        color: #1e293b;
        text-decoration: none;
    }

    .nav-links {
        display: flex;
        list-style: none;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 600;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: #0f172a;
        background-color: #f1f5f9;
    }

    @media (max-width: 768px) {
        .nav-container {
            flex-direction: column;
            gap: 1rem;
        }
        .nav-links {
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
    }
</style>
