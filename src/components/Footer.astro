---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer-content">
        <p>
            <strong>InclusiónTech</strong> — Promoviendo la accesibilidad y la autonomía
            digital.
        </p>
        <p class="copyright">
            &copy; {currentYear} Todos los derechos reservados.
        </p>
    </div>
</footer>

<style>
    .footer {
        background-color: #ffffff;
        border-top: 1px solid var(--border);
        padding: 2rem 1.5rem;
        margin-top: auto;
        text-align: center;
    }

    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .copyright {
        margin-top: 0.5rem;
        font-size: 0.85rem;
    }
</style>
