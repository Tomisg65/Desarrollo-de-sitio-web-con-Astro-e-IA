---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import AccessibilityBar from "../components/AccessibilityBar.astro";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Plataforma de herramientas tecnológicas para la inclusión digital.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@400;600;700&family=Nunito:wght@400;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title} | InclusiónTech</title>
    </head>
    <body>
        <AccessibilityBar />
        <Navbar />

        <main id="main-content">
            <slot />
        </main>

        <Footer />
    </body>
</html>

<style is:global>
    :root {
        --bg-main: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #334155;
        --text-muted: #64748b;
        --primary: #475569;
        --primary-light: #e2e8f0;
        --accent: #5b7083;
        --border: #e2e8f0;
        --font-heading: "Lexend Deca", sans-serif;
        --font-body: "Nunito", sans-serif;
        --base-size: 16px;
    }

    html {
        font-size: var(--base-size);
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: var(--font-body);
        background-color: var(--bg-main);
        color: var(--text-main);
        line-height: 1.6;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: var(--font-heading);
        color: #1e293b;
        line-height: 1.25;
    }

    main {
        flex: 1;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* Clases para modo alto contraste */
    body.high-contrast {
        --bg-main: #121212;
        --bg-card: #1e1e1e;
        --text-main: #f1f5f9;
        --text-muted: #cbd5e1;
        --border: #475569;
    }

    body.high-contrast h1,
    body.high-contrast h2,
    body.high-contrast h3 {
        color: #ffffff;
    }
</style>
